# ============================================================================
# 1. 专属变量配置区
# ============================================================================

# 编译器与编译选项
CXX = g++
CXXFLAGS = -std=c++17 -Wall -O2

# [1] 编译产物存放的细分目录 (指向输出目录)
OUT_DIR = ../../bin/example-FastDfs-demo

# [2] 最终生成的可执行文件完整路径
TARGET = $(OUT_DIR)/FastDfsDemo

# [3] 当前需要编译的所有源码文件
SRCS = FastDfsDemo.cpp

# [4] 编译时需要链接的外部动态库
LIBS = -lfdfsclient -lfastcommon -lpthread

# ============================================================================
# 2. 核心编译引擎区
# ============================================================================

# 声明伪目标，防止同名文件冲突
.PHONY: all clean run

# 默认 make 执行编译
all: $(TARGET)

# 真正的编译规则（注意：下面两行行首必须是真实的 TAB 制表符）
$(TARGET): $(SRCS)
	@mkdir -p $(OUT_DIR)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LIBS)

# 一键运行规则（提供默认测试参数，可随时按需修改）
run: $(TARGET)
	@$(TARGET)

# 一键清理规则
clean:
	@echo "🧹 正在为你无情清扫编译垃圾..."
	@rm -rf $(OUT_DIR)
	@echo "✨ 清理完毕！源码树已恢复绝对纯洁！"
